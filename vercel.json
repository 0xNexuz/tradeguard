{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/*.ts": {
      "maxDuration": 10,
      "includeFiles": "{lib/**,dist/server/**}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/site" }
  ]
}
